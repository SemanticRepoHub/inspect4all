# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
# Native language-detection libraries: the Linux .so is built in the Dockerfile
# enry stage; local mac/windows binaries must not leak into the image.
# Recursive globs are required — a leading *.ext only matches the context root.
**/*.so
**/*.dylib
**/*.dll
.Python
.venv
venv/
ENV/
.mypy_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing/Coverage
.coverage
htmlcov/
.tox/

# Docker
.docker/

# DevContainer
.devcontainer/

# Misc
*.log
.DS_Store
Thumbs.db
.env
.env.local
*.bak
