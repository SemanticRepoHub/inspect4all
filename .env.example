# Application settings
APP_NAME=inspect4all
APP_VERSION=0.1.0
DEBUG=false

# LLM enrichment (Phase 2) -- all variables are optional; defaults work with LM Studio locally
# See README "LLM Enrichment" section for full documentation.
INSPECT4ALL_LLM_BASE_URL=http://localhost:1234/v1
INSPECT4ALL_LLM_API_KEY=lm-studio
INSPECT4ALL_LLM_MODEL=qwen/qwen3.5-35b-a3b
INSPECT4ALL_LLM_TEMPERATURE=0.0
INSPECT4ALL_LLM_MAX_TOKENS=400
# INSPECT4ALL_LLM_REASONING_EFFORT=none  # Uncomment for reasoning models only
